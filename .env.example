# Store real credentials in ignored files or RunPod secrets, never this file.
FLUX_API_TOKEN_FILE=/workspace/secrets/flux-api-token
FLUX_METRICS_TOKEN_FILE=/workspace/secrets/flux-metrics-token
FLUX_DATA_DIR=/opt/flux-runtime
FLUX_MODEL_DIR=/workspace/models/flux2-dev
HF_HOME=/workspace/huggingface
PORT=8001
METRICS_PORT=8889
